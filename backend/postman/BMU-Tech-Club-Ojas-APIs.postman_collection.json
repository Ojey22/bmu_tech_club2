{
  "info": {
    "_postman_id": "8c6dc35b-2d89-4eea-bf19-ae6f7d9ca0a1",
    "name": "BMU Tech Club \u2014 Ojas Backend APIs",
    "description": "Public JSON read endpoints, admin-only JSON create/update endpoints, authenticated My Registrations, and the existing GitHub external API. Configure baseUrl, adminToken and studentToken before running protected requests. POST test records are persistent; remove generated test records from the respective JSON file after the run.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/health",
        "description": "Confirm that the Express server is responding."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Health endpoint responds successfully', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Get all events",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/local-data/events",
        "description": "Public: returns the events.json dataset."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Events list responds successfully', () => pm.response.to.have.status(200));",
              "pm.test('Response contains an array', () => pm.expect(pm.response.json().data).to.be.an('array'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Get event by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/local-data/events/web-development-workshop",
        "description": "Public: fetch one of the existing event records."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Event lookup responds successfully', () => pm.response.to.have.status(200));",
              "pm.test('Correct event is returned', () => pm.expect(pm.response.json().data.id).to.eql('web-development-workshop'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create event (admin)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/local-data/events",
        "description": "Admin only. Creates a test event in events.json. Use a unique ID; this record is persistent.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"{{eventId}}\",\n  \"title\": \"Postman API Test Event\",\n  \"date\": \"2026-12-10\",\n  \"displayDate\": \"10 December\",\n  \"time\": \"2:00 PM - 4:00 PM\",\n  \"venue\": \"Test Venue\",\n  \"description\": \"Temporary test record; remove from events.json after testing.\",\n  \"category\": \"Test\",\n  \"registrationPage\": \"web-development-register.html\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('eventId', 'postman-test-event-' + Date.now());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Event is created', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "if (body.data && body.data.id) pm.collectionVariables.set('eventId', body.data.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Update event (admin)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/local-data/events/{{eventId}}",
        "description": "Admin only. Updates the event created in the previous request.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"description\": \"Updated by Postman API test.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Event is updated', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
